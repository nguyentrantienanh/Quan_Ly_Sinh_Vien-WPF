<UserControl x:Class="Quanlysinhvien.Views.User.UserMainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="Auto" Width="Auto">
    <UserControl.Resources>
        <!-- Button Style for Sidebar Buttons -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Background" Value="#455A64"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#546E7A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#37474F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button Style for Logout -->
        <Style x:Key="LogoutButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Background" Value="#EF5350"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F44336"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#D32F2F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button Style for Exit -->
        <Style x:Key="ExitButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Background" Value="#37474F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#546E7A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#263238"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="#37474F" Padding="20">
            <StackPanel>
                <!-- Welcome Header -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,40" Width="207">
                    <TextBlock Text="Xin chào" FontSize="24" FontWeight="Bold" Foreground="White" 
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding LoggedInUserName}" FontSize="20" FontWeight="Medium" 
                               Foreground="#B0BEC5" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    <TextBlock Text="Hệ thống sinh viên" FontSize="16" FontWeight="Regular" 
                               Foreground="#78909C" HorizontalAlignment="Center" Margin="0,10,0,0" Width="134"/>
                </StackPanel>

                <!-- Menu Items with Icons -->
                <Button Content="📚 Đăng ký môn học" 
                        Style="{StaticResource SidebarButtonStyle}" 
                        Click="RegisterSubject_Click"/>
                <Button Content="📖 Danh sách môn học" 
                        Style="{StaticResource SidebarButtonStyle}" 
                        Click="ViewSubjects_Click"/>
                <Button Content="👤 Cập nhật thông tin" 
                        Style="{StaticResource SidebarButtonStyle}" 
                        Margin="0,0,0,30" 
                        Click="UpdateProfile_Click"/>
                <Button Content="🚪 Đăng xuất" 
                        Style="{StaticResource LogoutButtonStyle}" 
                        Click="Logout_Click"/>
                <!-- Exit Button -->
                <Button Content="🚫 Thoát" 
                        Style="{StaticResource ExitButtonStyle}" 
                        Click="Exit_Click" Margin="0,10,0,0" Background="#FFEF5350"/>
                <!-- Real-time Clock -->
                <TextBlock x:Name="RealTimeClock" FontSize="16" Foreground="#B0BEC5" 
                           HorizontalAlignment="Center" Margin="0,20,0,0" TextAlignment="Center" Width="170" Height="29" FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <!-- Content Area -->
        <Border Grid.Column="1" Background="#ECEFF1" Padding="20">
            <ContentControl x:Name="UserContent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <!-- Default Content -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Chọn một mục từ menu để bắt đầu" FontSize="20" Foreground="#78909C" 
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </ContentControl>
        </Border>
    </Grid>
</UserControl>