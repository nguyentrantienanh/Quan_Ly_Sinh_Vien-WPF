<UserControl x:Class="Quanlysinhvien.Views.User.UserSubjectListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="Auto" Width="Auto"
             Background="#F0F4F8">
    <UserControl.Resources>

        <!-- Header Style mạnh mẽ hơn -->
        <Style x:Key="DataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" ShadowDepth="0" BlurRadius="4" Opacity="0.2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dòng -->
        <Style x:Key="DataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Height" Value="40"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E3F2FD"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#90CAF9" ShadowDepth="0" BlurRadius="6" Opacity="0.3"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#BBDEFB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Ô dữ liệu -->
        <Style x:Key="DataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#37474F"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <TextBlock Grid.Row="0" Text="📘 Danh sách môn học đã đăng ký"
                   FontSize="20" FontWeight="Bold" Foreground="Black"
                   HorizontalAlignment="Left" Margin="0,0,0,20"/>

        <!-- Bảng -->
        <Border Grid.Row="1" CornerRadius="10" Background="White"
                Padding="10"
                Effect="{DynamicResource MaterialDesignShadowDepth2}">
            <DataGrid x:Name="RegisteredSubjectsDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      Background="Transparent"
                      BorderThickness="0"
                      AlternatingRowBackground="#F9FBFC"
                      RowBackground="Transparent"
                      ItemsSource="{Binding RegisteredSubjects}"
                      ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                      RowStyle="{StaticResource DataGridRowStyle}"
                      CellStyle="{StaticResource DataGridCellStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="📌 Mã môn học" Binding="{Binding IdSubject}" Width="160"/>
                    <DataGridTextColumn Header="📝 Tên môn học" Binding="{Binding SubjectName}" Width="*"/>
                    <DataGridTextColumn Header="⭐ Điểm" Binding="{Binding Mark}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Row Count -->
        <TextBlock Grid.Row="2"
                   Text="{Binding ElementName=RegisteredSubjectsDataGrid, Path=Items.Count, StringFormat='Tổng số bản ghi: {0}'}"
                   FontSize="14" Foreground="#37474F"
                   Margin="0,16,0,0" HorizontalAlignment="Right"/>
    </Grid>
</UserControl>
