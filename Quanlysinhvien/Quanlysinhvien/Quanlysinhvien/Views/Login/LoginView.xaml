<UserControl x:Class="Quanlysinhvien.Views.Login.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Quanlysinhvien"
             xmlns:vm="clr-namespace:Quanlysinhvien.ViewModels">

    <UserControl.DataContext>
        <vm:LoginViewModel/>
    </UserControl.DataContext>

    <Grid>
        <!-- Background Gradient -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#E3F2FD" Offset="0"/>
                <GradientStop Color="White" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Main Border -->
        <Border CornerRadius="20" Background="#FAFAFA" Padding="40"
                HorizontalAlignment="Center" VerticalAlignment="Center" 
                MinHeight="400" MinWidth="450" MaxWidth="600">
            <Border.Effect>
                <DropShadowEffect Color="#B0BEC5" Direction="320" ShadowDepth="5" BlurRadius="15" Opacity="0.4"/>
            </Border.Effect>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- Title -->
                <TextBlock Text="🔐 Đăng nhập hệ thống" FontSize="32" FontWeight="Bold"
                           Foreground="#1E88E5" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <!-- Username Input -->
                <StackPanel>
                    <TextBlock Text="Tên đăng nhập" FontSize="16" Foreground="#455A64" Margin="5,0,5,5"/>
                    <Grid Height="50" MinWidth="350">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="45"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Icon -->
                        <Border Background="White" BorderBrush="#CFD8DC" BorderThickness="1" CornerRadius="8,0,0,8">
                            <Grid Grid.Column="0" Background="#ECEFF1" HorizontalAlignment="Stretch">
                                <TextBlock Text="👤" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <!-- TextBox -->
                        <TextBox Grid.Column="1" BorderThickness="1" BorderBrush="#CFD8DC" 
                                 Padding="10,0" VerticalContentAlignment="Center" Background="#E2E2E0"
                                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" FontSize="16"/>
                    </Grid>
                </StackPanel>

                <!-- Password Input -->
                <StackPanel>
                    <TextBlock Text="Mật khẩu" FontSize="16" Foreground="#455A64" Margin="5,15,5,5"/>
                    <Grid Height="50" MinWidth="350">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="45"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Icon -->
                        <Border Background="White" BorderBrush="#CFD8DC" BorderThickness="1" CornerRadius="8,0,0,8">
                            <Grid Grid.Column="0" Background="#ECEFF1">
                                <TextBlock Text="🔒" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <!-- PasswordBox -->
                        <PasswordBox Grid.Column="1" BorderThickness="1" BorderBrush="#CFD8DC"
                                     Padding="10,0" VerticalContentAlignment="Center" FontSize="16" x:Name="PasswordBox"
                                     Background="#E2E2E0"/>
                    </Grid>
                </StackPanel>

                <!-- Buttons Panel -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,0">
                    <!-- Login Button -->
                    <Button Content="Đăng nhập" Width="180" Height="50"
                            Background="#2095FC" Foreground="White" FontSize="18" FontWeight="SemiBold"
                            BorderThickness="0" Cursor="Hand"
                            Command="{Binding LoginCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            Margin="0,0,10,0">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#42A5F5"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Background" Value="#1976D2"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Exit Button -->
                    <Button Content="Thoát" Width="180" Height="50"
        Background="#EF5350" Foreground="White" FontSize="18" FontWeight="SemiBold"
        BorderThickness="0" Cursor="Hand"
        Command="{Binding ExitCommand}"
        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
        Margin="10,0,0,0">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#E57373"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Background" Value="#D32F2F"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>