<UserControl x:Class="Quanlysinhvien.Views.Admin.AdminMainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <UserControl.Resources>
        <!-- Define Button Style with Hover and Pressed Effects -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Background" Value="#455A64"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Left"
                                             VerticalAlignment="Center"
                                             Margin="15,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#546E7A"/>
                                <Setter Property="Foreground" Value="#E0E0E0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#37474F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Logout Button Style -->
        <Style x:Key="LogoutButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Background" Value="#D32F2F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EF5350"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#B71C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Exit Button Style -->
        <Style x:Key="ExitButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Background" Value="#37474F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#546E7A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#263238"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="#37474F" Padding="20" CornerRadius="0,10,10,0">
            <StackPanel>
                <!-- Welcome Header -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,40">
                    <TextBlock Text="Xin chào" FontSize="24" FontWeight="Bold" Foreground="White" 
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="AdminNameTextBlock" Text="ADMIN" FontSize="20" FontWeight="Medium" 
                               Foreground="#B0BEC5" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    <TextBlock Text="Hệ thống quản trị" FontSize="16" FontWeight="Regular" 
                               Foreground="#78909C" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>

                <!-- Menu Items with Icons -->
                <Button Content="🎓 Quản lý Sinh viên" Style="{StaticResource SidebarButtonStyle}" 
                        Click="ManageStudent_Click"/>
                <Button Content="👥 Quản lý Người dùng" Style="{StaticResource SidebarButtonStyle}" 
                        Click="ManageUser_Click"/>
                <Button Content="🔑 Quản lý Vai trò" Style="{StaticResource SidebarButtonStyle}" 
                        Click="ManageRole_Click"/>
                <Button Content="⚙ Quản lý Phân quyền" Style="{StaticResource SidebarButtonStyle}" 
                        Click="ManageUserRole_Click"/>
                <Button Content="📚 Quản lý Môn học" Style="{StaticResource SidebarButtonStyle}" 
                        Click="ManageSubject_Click"/>
                <Button Content="🏙 Quản lý Tỉnh/TP" Style="{StaticResource SidebarButtonStyle}" 
                        Click="ManageProvince_Click"/>
                <Button Content="📋 Xem đăng ký môn học" Style="{StaticResource SidebarButtonStyle}" 
                        Click="ViewEnrolments_Click"/>

                <!-- Spacer -->
                <Rectangle Height="20" Fill="Transparent"/>

                <!-- Logout Button -->
                <Button Content="🚪 Đăng xuất" Style="{StaticResource LogoutButtonStyle}" 
                        Click="Logout_Click" Background="#FFF14545"/>

                <!-- Exit Button -->
                <Button Content="🚫 Thoát" Style="{StaticResource ExitButtonStyle}" 
                        Click="Exit_Click" Margin="0,10,0,0" Background="#FFF14545"/>

                <!-- Real-time Clock -->
                <TextBlock x:Name="RealTimeClock" FontSize="16" Foreground="#B0BEC5" 
                           HorizontalAlignment="Center" Margin="0,20,0,0" 
                           Text="{Binding Source={x:Static sys:DateTime.Now}, StringFormat='dd/MM/yyyy HH:mm:ss', Mode=OneWay}" VerticalAlignment="Bottom" FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <!-- Content Area -->
        <Border Grid.Column="1" Background="#ECEFF1" Padding="20" CornerRadius="10,0,0,10">
            <ContentControl x:Name="AdminContent">
                <!-- Default Content -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Chọn một mục từ menu để bắt đầu" FontSize="20" Foreground="#78909C" 
                               HorizontalAlignment="Center"/>
                </StackPanel>
                <ContentControl.Effect>
                    <DropShadowEffect Color="#CFD8DC" Direction="270" ShadowDepth="2" Opacity="0.2"/>
                </ContentControl.Effect>
            </ContentControl>
        </Border>
    </Grid>
</UserControl>